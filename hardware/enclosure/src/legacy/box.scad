// ============================================================================
//  Pi-Gaze / box.scad — блок Raspberry Pi ("хвост" за монитором)
//
//  ОРИЕНТАЦИЯ ПЛАТЫ: ребром CAM/DISP ВВЕРХ (шлейф камеры идёт к бару напрямую).
//    верх   — CAM/DISP  -> прорезь шлейфа (жёстких штекеров нет)
//    низ    — Ethernet + USB + USB
//    лево   — USB-C + micro-HDMI x2
//    право  — GPIO (наружу ничего не идёт)
//
//  СИММЕТРИЯ: поля слева и справа РАВНЫЕ -> плата стоит по центру X,
//  поэтому и кулер, и решётка крышки оказываются по центру корпуса.
//  Отсек CH9329 вынесен в ВЕРХНЕЕ поле (там нет жёстких штекеров).
// ============================================================================

// ------------------------------------------------------------------- поля
MG_SIDE = 3;    // равные -> симметрия по X
MG_BOT  = 3;    // снизу разъёмы: поле минимальное, чтобы штекер доставал
MG_TOP  = 20;   // сверху: фолд шлейфа + отсек CH9329

IN_X = 2*MG_SIDE + PCB_X;                            // 62
IN_Z = MG_BOT + PCB_Z + MG_TOP;                      // 108
IN_Y = STAND_H + PCB_T + COOLER_H + FAN_GAP + 2;     // 31.1

BOX_X = IN_X + 2*WALL;
BOX_Z = IN_Z + 2*WALL;
BOX_Y = IN_Y + WALL;      // задняя стенка глухая, перёд = крышка

// база платы (min X, min Z) и плоскость верха платы
PX0 = -IN_X/2 + MG_SIDE;          // -28  -> плата -28..+28, центр X = 0
PZ0 = WALL + MG_BOT;              // 5.5
PY  = -BOX_Y/2 + WALL + STAND_H + PCB_T;   // верх платы (от него растут разъёмы)
BACK_IN = -BOX_Y/2 + WALL;        // внутренняя грань задней стенки
FRONT   =  BOX_Y/2;               // плоскость стыка с крышкой

// магниты: 4 ПО УГЛАМ (локальные приливы вместо сплошных планок -> не мешают впайке)
MAG_CX = IN_X/2 - 6;                     // ~25, ближе к углам по X
MAG_CZ = [WALL+8, BOX_Z-WALL-8];         // ~10.5 и 102.5, у верх/низ кромок
function mag_list() = [ for(x=[-MAG_CX,MAG_CX]) for(z=MAG_CZ) [x,z] ];

// винты крепления платы: СВОБОДНАЯ диагональ монтажных отверстий Pi (кулер занимает другую)
SCREW_DIAG = 1;   // 1 или -1 — какую диагональ занимает НАШ винт. VERIFY по своему кулеру!
function board_screws() = [
  [ -(PX0+HOLE_X[1])*SCREW_DIAG, PZ0+HOLE_Z[0] ],   // напр. (-24.5, 29)
  [  (PX0+HOLE_X[1])*SCREW_DIAG, PZ0+HOLE_Z[1] ] ]; // напр. (+24.5, 87)

// вентиляция: группы, не пересекаются с разъёмами левой стенки (Z 51..80)
// Боковины: ТОЛЬКО приток внизу (зона 5..45 свободна на обеих стенках).
// Выброс — в ВЕРХНЕЙ грани (горячий воздух уходит вверх), симметрично по X.
VENT_LO = [12,17,22,27,32,37];
VENT_TOP_X = [-18,-12,-6,0,6,12,18];
VENT_Y  = BACK_IN + IN_Y/2;
VENT_L  = IN_Y - 10;

// отсек CH9329 в верхнем поле: плашмя у задней стенки, штекер влево
CH_Z = PZ0 + PCB_Z + MG_TOP/2;    // ~100.5
DOCK_BOX_X = 22;                  // док в задней стенке (совпадает с тисками)
DOCK_BOX_Z = BOX_Z - 14;
SD_X = 21;                        // microSD в верхней грани, зеркально по X (VERIFY)
PWR_TX = 24;                      // X толкателя кнопки питания на ВЕРХНЕЙ грани (рядом с SD/USB-C). VERIFY!

// ------------------------------------------------------------ проёмы разъёмов
module port_bottom(cx,w,h){
  translate([cx, PY + h/2 - 0.5, WALL]) rotate([180,0,0]) port_slot(w,h,WALL);
}
module port_left(cz,w,h){
  translate([-BOX_X/2+WALL, PY + h/2 - 0.5, cz]) rotate([0,-90,0]) port_slot(w,h,WALL);
}
module port_right(cz,w,h){
  translate([BOX_X/2-WALL, PY + h/2 - 0.5, cz]) rotate([0,90,0]) port_slot(w,h,WALL);
}

// ===========================================================================
module box_body(){
  difference(){
    union(){
      // --- оболочка: глухая задняя стенка, открытый перёд
      difference(){
        translate([0,-BOX_Y/2,BOX_Z/2]) extrudeY(BOX_Y) rrect(BOX_X,BOX_Z,4);
        translate([0,BACK_IN,BOX_Z/2]) extrudeY(BOX_Y) rrect(IN_X,IN_Z,3);
      }
      // --- ЛОКАЛЬНЫЕ приливы под магниты в 4 углах (узкие, центр горловины свободен;
      //     паяльник свободно достаёт до бобышек — планки больше не мешают впайке)
      for(m=mag_list()) translate([m[0], FRONT-2.2, m[1]]) cube([13, 4.4, 13], center=true);
      // --- 4 опоры платы задают плоскость посадки (высота STAND_H)
      for(x=[-1,1]) for(z=[PZ0+6, PZ0+PCB_Z-6])
        translate([x*(PCB_X/2-6), BACK_IN, z]) rotate([-90,0,0]) cylinder(d=7,h=STAND_H);
      // --- 2 бобышки-стойки с втулкой M2.5: сюда ПРИКРУЧИВАЕТСЯ плата (винт спереди
      //     сквозь монтажное отверстие Pi Ø2.7). Диагональ — свободная от кулера.
      for(p=board_screws())
        translate([p[0], 0, p[1]]) boss_pinsertY(BACK_IN, STAND_H, INS_M25_D, INS_M25_L);
      // --- нижние опоры платы В ЗАЗОРАХ между разъёмами (штекеры НЕ задеваются).
      //     Собранный блок висит ребром LAN/USB ВНИЗ -> плата опирается нижним
      //     ребром сюда. Зазоры (зеркально): RJ45|USB1 -> x=+7.6 ; USB1|USB2 -> x=-10.
      //     (контр-модель "botsup" доказывает отсутствие коллизии с телами разъёмов)
      for(x=[7.6, -10.05]){
        translate([x-1.5, BACK_IN, PZ0-3]) cube([3, STAND_H+PCB_T, 3]);           // ложе, верх на Z=PZ0
        translate([x-1.5, BACK_IN+STAND_H+PCB_T-0.4, PZ0-3]) cube([3, 1.4, 7]);   // передний бортик
      }
      // (верхние клипсы убраны: плата ПРИКРУЧЕНА винтами M2.5 -> выпасть не может)
      // --- отсек CH9329: ОТКРЫТАЯ колыбель. Модуль (34x15x9) кладётся спереди
      //     при снятой крышке, USB-торец смотрит ВПРАВО к проёму. Держат: задняя
      //     стенка + левый торец + пол/потолок; спереди прижимает крышка; вправо
      //     не даёт выйти узкий проём (тело 15x9 > проём 13x7). Модуль реально ВХОДИТ.
      translate([0, BACK_IN+CH_T/2+1, CH_Z]) difference(){
        cube([CH_L+4, CH_T+4, CH_W+4], center=true);                       // рамка (по центру X — обходит пятаки дока)
        translate([-2,2,0]) cube([CH_L+4, CH_T+4, CH_W+0.8], center=true); // полость, открыта +Y и -X
      }
      // --- направляющая ТОЛКАТЕЛЯ кнопки питания: тубус от верхней грани к кромке платы
      //     (по Y идёт над платой; не задевает CH9329 по центру и магниты у крышки)
      translate([PWR_TX, PY+1.5, 94]) cylinder(d=8, h=BOX_Z-WALL-94);
      // --- опорные площадки под головки болтов дока (задняя стенка нагружена)
      for(x=[-1,1]) translate([x*DOCK_BOX_X, BACK_IN, DOCK_BOX_Z]) rotate([-90,0,0]) cylinder(d=9,h=2.2);
      // (дистанционные рёбра убраны: блок висит на доке за задней губкой,
      //  до монитора ~45 мм воздуха — рёбра были не нужны и задевали губку)
    }
    // ====== ПОРТЫ (чертёж Pi 5, ЗЕРКАЛЬНО по X: плата вентилятором к крышке) ======
    // При взгляде на вентилятор (из-за крышки, +Y): HDMI/USB-C СЛЕВА = стенка +X,
    // USB/LAN снизу. X разъёмов = -(центр платы) относительно прежней раскладки.
    port_bottom(-(PX0+P_BOTTOM[0]), C_LAN[0],  C_LAN[1]);    // Ethernet
    port_bottom(-(PX0+P_BOTTOM[1]), C_USB[0],  C_USB[1]);    // USB-стек
    port_bottom(-(PX0+P_BOTTOM[2]), C_USB[0],  C_USB[1]);    // USB-стек
    port_right (PZ0+P_LEFT[0],   C_USBC[0], C_USBC[1]);   // USB-C      (стенка +X)
    port_right (PZ0+P_LEFT[1],   C_HDMI[0], C_HDMI[1]);   // micro-HDMI 0 (стенка +X)
    port_right (PZ0+P_LEFT[2],   C_HDMI[0], C_HDMI[1]);   // micro-HDMI 1 (стенка +X)
    // microSD НЕ выводим наружу: по чертежу карта стоит вплотную к USB-C, между
    // проёмами оставалась перемычка 1.1 мм (тонко и неопрятно). Крышка держится
    // на магнитах и снимается за секунду — карта меняется через неё.
    // USB-штекер CH9329 наружу через стенку -X (сторона GPIO, разъёмов платы там нет)
    translate([-BOX_X/2+WALL, BACK_IN+CH_T/2+1, CH_Z])
      rotate([0,-90,0]) port_slot(13, 7, WALL);
    // КНОПКА ПИТАНИЯ Pi 5: бор Ø5.2 под шток + ЗЕНКОВКА Ø9 под шляпку (чтобы шляпка ходила).
    // Толкатель (деталь `plunger`) стоит в тубусе, нижним торцом на кнопке. VERIFY X по плате!
    translate([PWR_TX, PY+1.5, 93]) cylinder(d=5.2, h=BOX_Z-93+1);          // бор под шток
    translate([PWR_TX, PY+1.5, 109]) cylinder(d=9, h=6);                    // зенковка под шляпку
    // --- ВЕРХНЯЯ грань ---
    // microSD НЕ выводим на верхнюю грань: кромка платы утоплена в поле CH9329 на ~20 мм,
    // прорезь до карты не дотянулась бы. Карта у верхней кромки на нижней стороне — меняется
    // снятием магнитной крышки (выбор: SD через крышку).
    // ШЛЕЙФ КАМЕРЫ (CSI): выход в верхней грани над разъёмами CAM/DISP. Проём широкий,
    // чтобы попасть в нужный из двух разъёмов (X точную позицию — VERIFY). Шлейф выходит
    // ВВЕРХ и уходит в канал НА НИЖНЕЙ грани перемычки тисков (между тисками и монитором),
    // т.е. защищён и не болтается; далее — к бару у оси шарнира (петля на наклон).
    translate([-11, PY+1.5, BOX_Z-WALL+0.5]) cube([24, 7, WALL+3], center=true);
    // ================= ВЕНТИЛЯЦИЯ: сквозные симметричные группы ==============
    for(sx=[-1,1]) for(z=VENT_LO) vent_x(sx, BOX_X/2, VENT_Y, z, VENT_L);
    // выброс: верхняя грань, передняя полоса по Y (уши дока стоят в задней) 
    for(x=VENT_TOP_X) translate([x, 8, BOX_Z-WALL+0.5]) cube([2.4, 11, WALL+3], center=true);
    // ================= МАГНИТЫ (в полках, снаружи не выступают) =============
    for(m=mag_list()) translate([m[0],0,m[1]]) mag_pocket_pY(FRONT);
    // ================= ДОК: проходные M3 в ЗАДНЕЙ стенке ====================
    // Бокс прижимается задней стенкой к бобышкам дока на губке тисков.
    for(x=[-1,1]) translate([x*DOCK_BOX_X, -BOX_Y/2-1, DOCK_BOX_Z]) rotate([-90,0,0]) cylinder(d=3.4,h=WALL+6);
  }
}

// ---------------------------------------------------------------------- крышка
// Чистая симметричная пластина: решётка строго по центру, никаких "ножек".
module box_lid(){
  gN=9; gsp=4.8; gh=52;
  difference(){
    union(){
      translate([0,FRONT+LID_TH/2,BOX_Z/2]) rbox3(BOX_X,LID_TH,BOX_Z,4);
      translate([0,FRONT-0.9,BOX_Z/2]) rbox3(IN_X-FIT,1.8,IN_Z-FIT,3);
      translate([0,FRONT-0.9,WALL+3]) cube([IN_X-12,5,5],center=true);   // зацеп снизу
    }
    for(i=[0:gN-1]) translate([(i-(gN-1)/2)*gsp, FRONT+LID_TH/2, BOX_Z/2])
      cube([2.4, LID_TH+6, gh], center=true);
    for(m=mag_list()) translate([m[0],0,m[1]]) mag_pocket_nY(FRONT);
  }
}


// ТОЛКАТЕЛЬ кнопки питания: шток в боре Ø5.2 + шляпка сверху. Печатать вертикально.
module pwr_plunger(){
  union(){
    cylinder(d=4.5, h=22);                     // шток (в бор Ø5.2)
    translate([0,0,19]) cylinder(d=8.5, h=5);  // шляпка (в зенковку Ø9), перекрывает шток
  }
}
