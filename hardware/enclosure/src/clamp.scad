// ============================================================================
//  Pi-Gaze / clamp.scad — тиски на верхнюю кромку монитора + шарнир бара + док кейса
//
//  МЕХАНИКА: перемычка ложится на ВЕРХ монитора. Передняя губа СВИСАЕТ на
//  LIP_DROP ниже кромки и цепляет переднюю рамку. Задняя губка уходит за
//  монитор; барашек M3 через невращающуюся пятку прижимает монитор вперёд.
//
//  КЕЙС: готовый RPi5-кейс (модифицирован в hardware/mount/case_mod.py) висит
//  ПРЯМО ПОД задней губкой, SD-торцом вверх, крышкой к монитору. Крепится
//  язычком-доком к наружной грани губки 2 винтами M3 (гайки в карманах на
//  внутренней грани губки -> кейс снимается сзади, не снимая тиски).
//
//  ШЛЕЙФ: одна прямая: из щели в торце кейса -> ТОННЕЛЬ внутри задней губки ->
//  закрытый паз по верху перемычки -> вверх в центральную щель бара. Шарнир
//  стоит на линии шлейфа (HINGE_X), поэтому камера бара ровно над пазом.
//
//  ВЗАИМОСВЯЗЬ С КЕЙСОМ: RIB_*, DOCK_*, JAW_* обязаны совпадать с
//  преобразованием подвеса в case_mod.py (HANG_T). Проверяется контр-моделью.
// ============================================================================

CL_W    = 56;    // ширина
REACH   = 48;    // раскрытие под монитор
TOP_T   = 7;     // толщина перемычки
JAW_T   = 7;     // толщина губок
REAR_H  = 48;    // задняя губка
LIP_DROP= 5;     // передняя губа свисает ниже кромки монитора (цепляет рамку, не лезет на матрицу)
LIP_H   = TOP_T + LIP_DROP;
HR      = 7;     // радиус кулака
HW      = 10;    // ширина кулака

HY      = -REACH/2 + 13;          // ось шарнира по Y
HINGE_X = -16.5;                  // шарнир на линии шлейфа (центр паза)
SCREW_Z = TOP_T - REAR_H*0.55;    // ось барашка
PIV_Z   = TOP_T + HR + 2;         // ось шарнира выше моста

JAW_Y0  = REACH/2 - JAW_T;        // 17  внутренняя грань задней губки (к монитору)
JAW_Y1  = REACH/2;                // 24  наружная грань
JAW_ZB  = TOP_T - REAR_H;         // -41 низ задней губки

// --- шлейф (совпадает с щелью в кейсе через HANG_T) ---
RIB_X0  = -25.5;  RIB_X1 = -7.5;  // тоннель/паз: шлейф 16 мм + зазор
RIB_Y0  = JAW_Y0 + 2;             // 19  тоннель внутри губки, стенки по 2 мм
RIB_Y1  = RIB_Y0 + 3;             // 22
GROOVE_Z0 = TOP_T - 3.5;          // дно паза по верху перемычки
GROOVE_YF = -4.0;                 // передний (открытый) конец паза: тут шлейф уходит вверх в бар (тумба с Y -5.4)
COVER_T   = 1.5;                  // крышка паза (деталь ribbon_cover)
COVER_X0  = -26.5; COVER_X1 = -1;
COVER_Y0  = 3;     COVER_Y1 = JAW_Y0 + 5.5;
COVER_SCREW_X = -3.25; COVER_SCREW_Y = [6, 14];
COVER_NUT_TOP = 4.4;              // верх кармана гайки крышки паза (винт M3x6 тянет гайку сюда)

// --- док кейса ---
DOCK_Z  = JAW_ZB + 5;             // -36 ось винтов дока
DOCK_XS = [14.5, 21.5];           // = отверстия язычка кейса через HANG_T (карманы гаек не заходят в скругление губки)

NUT_D   = (NUT_M3_AF+NUT_FIT)/cos(30);
KNOB_D  = 20;                     // маховик барашка (было 24: запас для пальцев рядом с доком)

module clamp(){
  difference(){
    union(){
      rbox(CL_W, REACH, TOP_T, 4);                                                  // перемычка
      translate([0, REACH/2-JAW_T/2, JAW_ZB]) rbox(CL_W, JAW_T, REAR_H, 3);          // задняя губка
      translate([0,-REACH/2+JAW_T/2, TOP_T-LIP_H]) rbox(CL_W, JAW_T, LIP_H, 3);      // передняя губа (свисает)
      translate([HINGE_X,HY,PIV_Z/2]) cube([HW, HR*1.6, PIV_Z], center=true);        // тумба
      translate([HINGE_X,HY,PIV_Z]) rotate([0,90,0]) cylinder(r=HR, h=HW, center=true); // кулак
      translate([0, JAW_Y0, SCREW_Z]) rotate([-90,0,0])                               // бобышка барашка
        cylinder(d=NUT_D+2*BOSS_WALL, h=JAW_T+7);
    }
    // ось шарнира
    translate([HINGE_X,HY,PIV_Z]) rotate([0,90,0]) cylinder(d=SCREW_M3_D, h=HW+2, center=true);
    // барашек: проход + гайка в кармане, ОТКРЫТОМ на внутреннюю грань (вставляется со стороны
    // монитора; нагрузка винта прижимает гайку ко дну кармана)
    translate([0, REACH/2+10, SCREW_Z]) rotate([90,0,0]) cylinder(d=SCREW_M3_D, h=JAW_T+30);
    translate([0, JAW_Y0-0.1, SCREW_Z]) rotate([-90,0,0]) cylinder(d=NUT_D, h=NUT_M3_TH+0.4, $fn=6);
    // ниша мягкой прокладки: по полосе контакта с рамкой (Z -4.5..3.5)
    translate([0,-REACH/2+JAW_T-0.7, -0.5]) cube([CL_W-14, 1.4, LIP_H-4], center=true);
    // док: 2x M3 сквозь губку + гайки в карманах на ВНУТРЕННЕЙ грани
    for(x=DOCK_XS) translate([x, JAW_Y0, DOCK_Z]) rotate([-90,0,0]){
      translate([0,0,-1]) cylinder(d=SCREW_M3_D, h=JAW_T+2);
      translate([0,0,-0.1]) cylinder(d=NUT_D, h=NUT_M3_TH+0.4, $fn=6);
    }
    // тоннель шлейфа внутри задней губки: от нижней грани до верха
    translate([RIB_X0, RIB_Y0, JAW_ZB-1]) cube([RIB_X1-RIB_X0, RIB_Y1-RIB_Y0, TOP_T-JAW_ZB+2]);
    // паз по верху перемычки (от выхода тоннеля вперёд до бара) + ступенька под крышку
    translate([RIB_X0, GROOVE_YF, GROOVE_Z0]) cube([RIB_X1-RIB_X0, RIB_Y1-GROOVE_YF, 10]);
    translate([COVER_X0, COVER_Y0, TOP_T-COVER_T]) cube([COVER_X1-COVER_X0, COVER_Y1-COVER_Y0, 10]);
    // винты крышки паза M3x6 + гайки в карманах, ПОДНЯТЫХ внутрь перемычки (вход снизу):
    // гайка у верха кармана (Z 1.8..4.2), конец винта на Z 1.0 — не выходит из-под перемычки
    // и не давит на кромку монитора (с M3x8 и гайкой у низа конец торчал бы на 1 мм)
    for(y=COVER_SCREW_Y) translate([COVER_SCREW_X, y, 0]){
      translate([0,0,-1]) cylinder(d=SCREW_M3_D, h=TOP_T+2);
      translate([0,0,-0.1]) cylinder(d=NUT_D, h=COVER_NUT_TOP+0.1, $fn=6);
    }
  }
}

// крышка паза шлейфа (моделируется на месте; при экспорте кладётся плашмя)
module ribbon_cover(){
  difference(){
    translate([COVER_X0+0.2, COVER_Y0+0.2, TOP_T-COVER_T])
      cube([COVER_X1-COVER_X0-0.4, COVER_Y1-COVER_Y0-0.4, COVER_T-0.05]);
    for(y=COVER_SCREW_Y) translate([COVER_SCREW_X, y, 0]) cylinder(d=SCREW_M3_D, h=20);
  }
}

// мягкая прокладка передней губы (печатать TPU): входит в нишу 42 x 1.4 x 8
module clamp_pad(){ rbox(CL_W-15, 1.4, LIP_H-4.4, 1.5); }

// ручка-маховик барашка (M3). Гекс-гнездо захватывает ГОЛОВКУ болта M3 DIN933 (под ключ 5.5),
// по краю — пальцевые канавки. Печатать плашмя.
module clamp_knob(){
  difference(){
    cylinder(d=KNOB_D, h=7, $fn=60);
    for(a=[0:20:359]) rotate([0,0,a]) translate([KNOB_D/2+0.5,0,-0.1]) cylinder(d=3.4, h=7.2, $fn=20);  // канавки
    translate([0,0,-0.1]) cylinder(d=(5.5+0.35)/cos(30), h=3.4, $fn=6);   // гнездо под головку M3
    translate([0,0,-0.1]) cylinder(d=SCREW_M3_D, h=7.2);                  // проход стержня
  }
}

// НЕвращающаяся пятка барашка: шаровое гнездо под торец винта,
// плоская площадка прижимается к монитору и не проворачивается.
module clamp_foot(){
  difference(){
    union(){
      rbox(24, 4, 18, 3);                                        // площадка (грань -Y к монитору), Y -2..2
      translate([0,-2,9]) rotate([-90,0,0]) cylinder(d=10, h=7); // прилив врастает в площадку (Y -2..5)
    }
    translate([0,5,9]) rotate([-90,0,0]) sphere(d=4.6);         // гнездо-полусфера, открыто к винту (+Y)
  }
}
