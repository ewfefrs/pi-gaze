// ============================================================================
//  Pi-Gaze / params.scad
//  Единый источник размеров. Всё остальное считается отсюда.
//  Единицы: мм.
//
//  ИСТОЧНИКИ ДАННЫХ:
//   [D] официальный механический чертёж Raspberry Pi 5
//       (datasheets.raspberrypi.com/rpi5/raspberry-pi-5-mechanical-drawing.pdf)
//   [M] замер пользователя штангенциркулем
//   [S] отраслевой стандарт разъёма
// ============================================================================

$fn = 56;

// ---------------------------------------------------------------- материалы
WALL      = 2.5;    // основная стенка
LID_TH    = 3.2;    // крышки (магнит 2 + потолок 0.4 + корка 0.8)
FIT       = 0.35;   // зазор бортиков крышек
CHAM      = 0.8;    // фаска-заход у проёмов разъёмов

// ------------------------------------------------------------------ магниты
// N42 диск 5 x 2 (заказаны)
MAG_D     = 5.0;
MAG_H     = 2.0;
MAG_FIT   = 0.2;
MAG_PD    = MAG_D + MAG_FIT;
MAG_CEIL  = 0.4;    // потолок над магнитом -> впаивается на паузе, снаружи не видно

// -------------------------------------------------------------- термовтулки
// ВАЖНО (правило heat-set): отверстие под втулку ВСЕГДА чуть МЕНЬШЕ её наружного
// (накатанного) диаметра — расплавленный пластик затекает в накатку и держит.
// Значения ниже — типовые рекомендованные отверстия; сверь с даташитом своих втулок.
// Втулки остаются ТОЛЬКО в креплении платы (M2.5). Всё прочее — гайки в карманах.
INS_M2_D  = 3.2;  INS_M2_L  = 4.0;
INS_M25_D = 3.5;  INS_M25_L = 5.0;   // <- крепление платы (отверстия Pi Ø2.7 => только M2.5)
INS_M3_D  = 4.0;  INS_M3_L  = 5.7;
INS_M5_D  = 6.4;  INS_M5_L  = 9.5;
INS_SLACK = 1.5;  // запас глубины под вытесненный пластик
BOSS_WALL = 2.0;  // мин. пластик вокруг втулки

// ------------------------------------------------------- гайки в карманах (M3)
// Единый крепёж корпуса — M3 винт + обычная M3-гайка в напечатанном кармане.
// ПРОВЕРЬ гайки: AF = размер под ключ (грани), TH = толщина.
NUT_M3_AF  = 5.5;   // M3 гайка, под ключ (DIN934/ISO4032)
NUT_M3_TH  = 2.4;   // M3 гайка, толщина
NUT_FIT    = 0.35;  // зазор карман/гайка (снуг, чтобы не проворачивалась)
SCREW_M3_D = 3.4;   // проход под винт M3 (+зазор)
SCREW_M25_D= 2.9;   // проход под винт M2.5

// =========================================================== RASPBERRY PI 5
// Плата 85 x 56 [D]. В корпусе стоит ребром CAM/DISP ВВЕРХ (поворот 90° CW),
// поэтому в координатах корпуса: X = 56 мм, Z = 85 мм.
PCB_X = 56;
PCB_Z = 85;
PCB_T = 1.6;

// Крепёж [D]: вдоль ребра 85 -> 3.5 и 61.5 ; вдоль ребра 56 -> 3.5 и 52.5.
// После поворота: X_b = Y_d ; Z_b = 85 - X_d
HOLE_X = [3.5, 52.5];
HOLE_Z = [23.5, 81.5];

// --- РАЗЪЁМЫ: позиции центров от угла платы (min X, min Z) --------------
// НИЗ (ребро 56, в чертеже правое): Ethernet, USB-стек, USB-стек [D]
P_BOTTOM = [10.2, 29.1, 47.0];
// ЛЕВО (ребро 85, в чертеже нижнее): USB-C, micro-HDMI 0, micro-HDMI 1
// (в чертеже 11.2/25.8/39.2 от левого края -> Z_b = 85 - X_d)
P_LEFT   = [73.8, 59.2, 45.8];

// --- РАЗЪЁМЫ: проём [ширина вдоль ребра, высота над платой] -------------
// ТЕЛА РАЗЪЁМОВ ИЗМЕРЕНЫ НА РЕАЛЬНОЙ 3D-МОДЕЛИ [S3D]
// (RASPBERRY_PI_5_WITH_ACTIVE_COOLER.stl, ~120k tri). Плата в модели центрирована
// в 0: нижняя медь A[-42.5,+42.5]=85, B[-28,+28]=56. Отображение в корпус
// (собственный поворот, кулер к крышке +Y, LAN/USB вниз -Z):  worldX = B ,
// worldZ = 48 - A. Центры разъёмов ПОДТВЕРДИЛИСЬ до 0.1 мм с чертёжными:
//   RJ45   центр worldX +17.8 (тело 15.90 x 13.68)
//   USB-A  центры worldX -1.1 / -19.0 (тело 13.25 x 15.80 — стек 2xUSB)
//   USB-C  центр worldZ 79.3 (тело 8.94 x 3.16)
//   HDMI   центры worldZ 64.7 / 51.3 (тело 6.50 x 2.88)
// ПРОЁМ = тело + ~0.7 мм суммарного зазора (0.35 на сторону) — снуг для FDM.
// Прежде C_USB высота 15.7 = телу 15.8 (нулевой зазор!) -> поднято до 16.5.
C_LAN    = [16.6, 14.4];   // 15.90 + 0.7  x  13.68 + 0.7
C_USB    = [14.0, 16.5];   // 13.25 + 0.75 x  15.80 + 0.7
C_USBC   = [ 9.6,  4.6];   //  8.94 + 0.66 x   3.16 + запас под штекер
C_HDMI   = [ 7.3,  4.4];   //  6.50 + 0.8  x   2.88 + запас под штекер
C_SD     = [13.0,  3.5];   // microSD, на нижней стороне у USB-C [S3D] (наружу НЕ выводим)

// --- прочее по плате
COOLER_H  = 15;   // Active Cooler над платой (VERIFY по STEP)
FAN_GAP   = 8;    // ОБЯЗАТЕЛЬНЫЙ зазор над турбинкой (иначе задыхается)
STAND_H   = 4.5;  // высота опор: зазор под пины кулера и нижние компоненты

// ============================================================ CAMERA MODULE 3
CAM_X = 25; CAM_Z = 24; CAM_T = 11.5;   // 25 x 24 x 11.5 [офиц. product brief]
CAM_FIT = 0.3;
CAM_LENS_D = 9;     // окно объектива
HOOD_H = 4;         // бленда (режет засветку от комнаты/экрана)

// ================================================================== ИК-ПОДСВЕТКА
// Vishay TSHA5203, 5 мм, 875 нм, ±12°, рабочий ток 20 мА
IR_WELL_D = 5.05;   // глухой колодец (press-fit, буртик не даёт провалиться)
IR_APER_D = 3.6;    // выходная апертура = светозащитный барьер к объективу
IR_SPACING = 44;    // база между диодами (dark-pupil: вынос от оси >= 15)

// ===================================================================== CH9329
// UART -> USB HID (мышь+клавиатура). ПРОВЕРЬ свой модуль.
CH_L = 34; CH_W = 15; CH_T = 9;
